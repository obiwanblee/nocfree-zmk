 LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 
+#if IS_ENABLED(CONFIG_ZMK_KSCAN_DEDICATED_WORKQUEUE)
+/* NocFree patch: run the scan on its OWN thread, not the shared system
+ * workqueue. On boards with a slow scan (e.g. keys behind I2C expanders) the
+ * scan work otherwise queues FIFO behind BLE/backlight work; when that backs
+ * up, the scan slips its absolute deadline and a key release is lost (stuck
+ * key), and a severe backlog can starve BLE into a supervision timeout (the
+ * stuck-key-then-disconnect cascade). A private thread one priority above the
+ * system workqueue (-1) cannot be blocked by that backlog. The radio link
+ * layer is ISR-driven (IRQ prio 0/1) so it is unaffected by any thread
+ * priority; the scan also yields during its own I2C reads, so it never
+ * monopolises the CPU. */
+K_THREAD_STACK_DEFINE(kscan_direct_wq_stack, CONFIG_ZMK_KSCAN_DEDICATED_WORKQUEUE_STACK_SIZE);
+static struct k_work_q kscan_direct_wq;
+static bool kscan_direct_wq_started;
+
+static void kscan_direct_wq_ensure_started(void) {
+    if (!kscan_direct_wq_started) {
+        kscan_direct_wq_started = true;
+        k_work_queue_start(&kscan_direct_wq, kscan_direct_wq_stack,
+                           K_THREAD_STACK_SIZEOF(kscan_direct_wq_stack),
+                           CONFIG_ZMK_KSCAN_DEDICATED_WORKQUEUE_PRIORITY, NULL);
+        k_thread_name_set(&kscan_direct_wq.thread, "kscan");
+    }
+}
+
+#define KSCAN_DIRECT_RESCHEDULE(dwork, delay)                                                      \
+    k_work_reschedule_for_queue(&kscan_direct_wq, dwork, delay)
+#else
+static inline void kscan_direct_wq_ensure_started(void) {}
+#define KSCAN_DIRECT_RESCHEDULE(dwork, delay) k_work_reschedule(dwork, delay)
+#endif
+
