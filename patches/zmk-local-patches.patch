     data->scan_time += config->debounce_scan_period_ms;
 
-    k_work_reschedule(&data->work, K_TIMEOUT_ABS_MS(data->scan_time));
+    KSCAN_DIRECT_RESCHEDULE(&data->work, K_TIMEOUT_ABS_MS(data->scan_time));
