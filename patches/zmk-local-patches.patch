+int zmk_ble_force_readvertise(void) {
+    // NocFree patch: update_advertising() is only invoked from BT events and
+    // trusts advertising_status. One failed bt_le_adv_start (classic case:
+    // restart racing conn cleanup right after a disconnect) or a stale status
+    // leaves the advertiser silently off with nothing left to retry it. Reset
+    // reality and the cache, then re-run the normal state machine.
+    bt_le_adv_stop();
+    advertising_status = ZMK_ADV_NONE;
+    return update_advertising();
+}
+
 static void update_advertising_callback(struct k_work *work) { update_advertising(); }
 
 K_WORK_DEFINE(update_advertising_work, update_advertising_callback);
